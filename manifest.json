{
  "manifest_version": 2,
  "name": "YouTube Auto Multi Open",
  "version": "1.0",
  "description": "Opens 10 YouTube windows with loop, 0.25 speed, and 144p.",
  "permissions": [
    "tabs",
    "*://*.youtube.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "Open 10 YouTube Windows"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["injector.js"],
      "run_at": "document_idle"
    }
  ]
}